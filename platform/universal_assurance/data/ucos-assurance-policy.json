{
  "$comment": "UCOS-EPIC-014 — the canonical Universal Assurance Policy. This document is the SINGLE SOURCE of assurance truth: every obligation, gate, metric, required evidence artifact, binding and reproducibility requirement the engine acts on is declared here and bound at run time to the reused platform engines (platform.universal_validation, platform.validation_intelligence, engine.universal_certification). Adding an obligation, tightening a threshold or composing a new gate is a DATA change, never a code change. Authority is ENGINEERING-EXECUTION-ONLY (DE-05 / IP-01): this policy confers no constitutional finality.",
  "policy": {
    "id": "UCOS-ASSURANCE-POLICY-001",
    "name": "Universal Validation & Certification Assurance Policy",
    "version": "1.0.0",
    "authority": "ENGINEERING-EXECUTION-ONLY",
    "fail_closed": true,
    "description": "Declares the ten owned assurance capabilities as bound obligations over the reused validation and certification platform, with measurable gates and a reproducibility contract."
  },
  "obligations": [
    {
      "id": "VO-ARCH-LAYERS",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "architecture.layers-declared",
      "severity": "blocking",
      "requires_facts": ["validation.architecture"],
      "rationale": "A system with no declared layers cannot be reasoned about architecturally."
    },
    {
      "id": "VO-ARCH-ACYCLIC",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "architecture.dependencies-acyclic",
      "severity": "blocking",
      "requires_facts": ["validation.architecture"],
      "rationale": "A cyclic architecture graph makes layering and build order undecidable."
    },
    {
      "id": "VO-ARCH-LAYERING",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "architecture.layering-respected",
      "severity": "blocking",
      "requires_facts": ["validation.architecture"],
      "rationale": "Upward dependencies dissolve the layering contract."
    },
    {
      "id": "VO-ARCH-FROZEN",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "architecture.no-frozen-writes",
      "severity": "blocking",
      "requires_facts": ["validation.architecture"],
      "rationale": "The certified corpus is read-only to implementation (DP-03 / C-01)."
    },
    {
      "id": "VO-IMPL-MODULES",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "implementation.modules-present",
      "severity": "blocking",
      "requires_facts": ["validation.implementation"],
      "rationale": "A declared module that is absent is an unrealized claim."
    },
    {
      "id": "VO-IMPL-ENTRYPOINTS",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "implementation.entrypoints-resolved",
      "severity": "blocking",
      "requires_facts": ["validation.implementation"],
      "rationale": "An unresolved entrypoint cannot be executed or certified."
    },
    {
      "id": "VO-IMPL-MARKERS",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "implementation.no-open-markers",
      "severity": "advisory",
      "requires_facts": ["validation.implementation"],
      "rationale": "Open work markers are recorded as evidence but do not block readiness."
    },
    {
      "id": "VO-DEP-PINNED",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "dependency.all-pinned",
      "severity": "blocking",
      "requires_facts": ["validation.dependency"],
      "rationale": "An unpinned dependency makes the build irreproducible (DE-04)."
    },
    {
      "id": "VO-DEP-RESOLVED",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "dependency.resolved",
      "severity": "blocking",
      "requires_facts": ["validation.dependency"],
      "rationale": "A dependency with no known provider cannot be sourced."
    },
    {
      "id": "VO-DEP-ACYCLIC",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "dependency.acyclic",
      "severity": "blocking",
      "requires_facts": ["validation.dependency"],
      "rationale": "A cyclic dependency graph has no valid resolution order."
    },
    {
      "id": "VO-REG-WELLFORMED",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "registry.entries-well-formed",
      "severity": "blocking",
      "requires_facts": ["validation.registry"],
      "rationale": "Registry Truth requires every entry to carry an id, kind and content hash."
    },
    {
      "id": "VO-REG-UNIQUE",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "registry.ids-unique",
      "severity": "blocking",
      "requires_facts": ["validation.registry"],
      "rationale": "Duplicate registry ids make canonical ownership ambiguous."
    },
    {
      "id": "VO-REG-REFERENTIAL",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "registry.referential-integrity",
      "severity": "blocking",
      "requires_facts": ["validation.registry"],
      "rationale": "A dangling reference breaks traceability closure."
    },
    {
      "id": "VO-SCHEMA-VERSIONED",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "schema.versioned",
      "severity": "blocking",
      "requires_facts": ["validation.schema"],
      "rationale": "An unversioned schema cannot be evolved compatibly (AR-03 / PL-05)."
    },
    {
      "id": "VO-SCHEMA-CONFORM",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "schema.records-conform",
      "severity": "blocking",
      "requires_facts": ["validation.schema"],
      "rationale": "A record that violates its schema is not admissible data."
    },
    {
      "id": "VO-RUNTIME-DISCLOSURE",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "runtime.disclosure-present",
      "severity": "blocking",
      "requires_facts": ["validation.runtime"],
      "rationale": "Every artifact must carry the EC-1 provisional-state disclosure (DE-05)."
    },
    {
      "id": "VO-RUNTIME-IDENTITY",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "runtime.identity-deterministic",
      "severity": "blocking",
      "requires_facts": ["validation.runtime"],
      "rationale": "A non-deterministic runtime identity is not reproducible (IMP-007 §5)."
    },
    {
      "id": "VO-RUNTIME-IMAGE",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "runtime.image-digest-pinned",
      "severity": "blocking",
      "requires_facts": ["validation.runtime"],
      "rationale": "An unpinned image reference makes the deployed artifact unverifiable."
    },
    {
      "id": "VO-QUALITY-COVERAGE",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "quality.coverage-threshold",
      "severity": "blocking",
      "requires_facts": ["validation.quality"],
      "rationale": "Coverage below the declared floor leaves behaviour unproven."
    },
    {
      "id": "VO-QUALITY-TESTS",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "quality.tests-passing",
      "severity": "blocking",
      "requires_facts": ["validation.quality"],
      "rationale": "A failing or empty test run proves nothing."
    },
    {
      "id": "VO-QUALITY-LINT",
      "stage": "validation-execution",
      "kind": "validation-rule",
      "ref": "quality.lint-clean",
      "severity": "advisory",
      "requires_facts": ["validation.quality"],
      "rationale": "Lint findings are recorded as evidence but do not block readiness."
    },
    {
      "id": "IO-CROSS-CAPABILITY",
      "stage": "validation-intelligence",
      "kind": "intelligence-dimension",
      "ref": "cross_capability_consistency",
      "severity": "blocking",
      "requires_facts": ["intelligence.cross_capability_consistency"],
      "rationale": "Capabilities must agree: unique ids, provided requirements, single providers."
    },
    {
      "id": "IO-REPOSITORY-COMPLETENESS",
      "stage": "validation-intelligence",
      "kind": "intelligence-dimension",
      "ref": "repository_completeness",
      "severity": "blocking",
      "requires_facts": ["intelligence.repository_completeness"],
      "rationale": "An incomplete repository cannot support a completeness determination."
    },
    {
      "id": "IO-CONTRACT-COMPATIBILITY",
      "stage": "validation-intelligence",
      "kind": "intelligence-dimension",
      "ref": "contract_compatibility",
      "severity": "blocking",
      "requires_facts": ["intelligence.contract_compatibility"],
      "rationale": "A removed or narrowed contract breaks existing consumers."
    },
    {
      "id": "IO-ARCHITECTURE-COMPLIANCE",
      "stage": "validation-intelligence",
      "kind": "intelligence-dimension",
      "ref": "architecture_compliance",
      "severity": "blocking",
      "requires_facts": ["intelligence.architecture_compliance"],
      "rationale": "Declared architecture policy must actually hold over the change set."
    },
    {
      "id": "IO-RUNTIME-COMPATIBILITY",
      "stage": "validation-intelligence",
      "kind": "intelligence-dimension",
      "ref": "runtime_compatibility",
      "severity": "blocking",
      "requires_facts": ["intelligence.runtime_compatibility"],
      "rationale": "A runtime that drops a required interface or bumps ABI major is breaking."
    },
    {
      "id": "IO-VERSION-COMPATIBILITY",
      "stage": "validation-intelligence",
      "kind": "intelligence-dimension",
      "ref": "version_compatibility",
      "severity": "blocking",
      "requires_facts": ["intelligence.version_compatibility"],
      "rationale": "An unsatisfied inter-component version requirement is a latent break."
    },
    {
      "id": "IO-GOVERNANCE-COMPLIANCE",
      "stage": "validation-intelligence",
      "kind": "intelligence-dimension",
      "ref": "governance_compliance",
      "severity": "blocking",
      "requires_facts": ["intelligence.governance_compliance"],
      "rationale": "Authority must stay bounded to engineering execution and be disclosed."
    },
    {
      "id": "CO-VALIDATION-ACCEPTED",
      "stage": "certification-execution",
      "kind": "certification-criterion",
      "ref": "validation-accepted",
      "severity": "blocking",
      "requires_facts": [],
      "rationale": "Certification aggregates the validation verdict; it never re-judges it."
    },
    {
