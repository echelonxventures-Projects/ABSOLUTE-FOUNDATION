        }
      ],
      "entry_point": "ucos-foundation",
      "cli": "platform.universal_foundation.cli:main",
      "catalogs": ["catalog/ucos-consolidation.json"],
      "dependencies": ["UCOS-URTF-001", "UCOS-UOF-001", "UCOS-USAF-001", "UCOS-UMPF-001", "UCOS-UFC-001"]
