{
  "title": "UCOS Ω∞ Security Finding / Control Entity",
  "description": "A security intelligence entity (UKB-005): vulnerability/finding, control, threat, exception, pentest/compliance/audit evidence. State and severity come from scanner signals; exceptions are time-boxed and auto-expire. Never stores secret values (RR-07).",
  "type": "object",
  "additionalProperties": false,
  "required": ["universal_id", "name", "finding_kind"],
  "properties": {
    "universal_id": { "type": "string", "pattern": "^UCOS-FND-[0-9]{6}$" },
    "name": { "type": "string", "minLength": 1 },
    "finding_kind": { "type": "string", "enum": ["VULNERABILITY", "CONTROL", "THREAT", "EXCEPTION", "PENTEST", "COMPLIANCE_EVIDENCE", "AUDIT_EVIDENCE"] },
    "identifier": { "type": ["string", "null"], "description": "CVE / rule id / control id (NIST/ISO/CIS).", "default": null },
    "severity": { "type": ["string", "null"], "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO", null], "default": null },
    "cvss": { "type": ["number", "null"], "default": null },
    "state": { "type": "string", "enum": ["OPEN", "IN_PROGRESS", "ACCEPTED", "RESOLVED", "FALSE_POSITIVE"], "default": "OPEN" },
    "affects": { "type": "array", "items": { "type": "string", "pattern": "^UCOS-[A-Z][A-Z0-9]{1,11}-[0-9]{6}$" }, "default": [] },
    "mitigates": { "type": "array", "items": { "type": "string" }, "default": [], "description": "For CONTROL: threats/architecture it mitigates." },
    "sla_due": { "type": ["string", "null"], "format": "date-time", "default": null },
    "exception_of": { "type": ["string", "null"], "pattern": "^UCOS-FND-[0-9]{6}$", "default": null },
    "approver": { "type": ["string", "null"], "default": null },
    "expires": { "type": ["string", "null"], "format": "date-time", "default": null },
    "evidence": { "type": ["string", "null"], "default": null },
    "derived_status": { "type": "string", "default": "OPEN" }
  }
}
